<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Swagger publishes the XML comments as endpoint and schema descriptions. 1591 stays off:
         documenting every public member is not the point, describing the API is. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- Development secrets - the connection string and the signing key - live outside the
         repository, in the per-user secret store this id points at. -->
    <UserSecretsId>campaign-reward-api-8f2a41c6</UserSecretsId>
  </PropertyGroup>

  <!--
    Campaign.Api references Campaign.Infrastructure only to register it in the DI container
    (a single AddInfrastructure call in Program.cs). Controllers and use cases stay on Core types.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Campaign.Core\Campaign.Core.csproj" />
    <ProjectReference Include="..\Campaign.Infrastructure\Campaign.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
