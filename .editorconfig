# Shared code style for the solution.
# Reference: https://learn.microsoft.com/dotnet/fundamentals/code-analysis/code-style-rule-options
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,html,css,js}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Namespaces and using directives
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Expression preferences - close to the default templates, nothing exotic
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning

# Private fields are _camelCase
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.severity = warning
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case_with_underscore.style = underscore_prefix

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _
